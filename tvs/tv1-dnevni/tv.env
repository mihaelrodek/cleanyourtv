# TV 1 — source this from the repo root: `source tvs/tv1-dnevni/tv.env`
export TV_HOST=192.168.1.27
export TV_MODEL="Philips 55PUS6412/12"
export TV_PLATFORM="TPM171E / PH7M_EU_5596 / MediaTek MT5891"
export TV_ANDROID=8                     # API 26
export TV_DEBLOAT="examples/philips-55pus6412/debloat.txt"
export TV_THEME="themes/philips-55pus6412"
export TV_STOCK_LAUNCHER="com.google.android.tvlauncher"
export TV_HOME="hr.telekom.android.maxtvp"   # MAXtv kept as Home; reach the launcher with the remote TV key
export TV_PRIVATE_DNS=no                 # Android 8, no Private DNS; ad-block at network level
