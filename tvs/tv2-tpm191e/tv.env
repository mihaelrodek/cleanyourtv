# TV 2 — source this from the repo root: `source tvs/tv2-tpm191e/tv.env`
# FILL IN TV_HOST once the TV is on the LAN with debugging on.
export TV_HOST=192.168.1.199
export TV_MODEL="Philips (PH9M_EA_5599) — exact model TBD"
export TV_PLATFORM="TPM191E / PH9M_EA_5599 / MediaTek MT5887"
export TV_ANDROID=12                     # API 31
export TV_DEBLOAT="examples/philips-tpm191e/debloat.txt"   # upstream list; fingerprint matches this TV
export TV_THEME="themes/philips-tpm191e" # TODO: create by copying themes/philips-55pus6412 and adjusting
export TV_STOCK_LAUNCHER="com.google.android.tvlauncher"
export TV_HOME=                          # TODO: decide (MAXtv kept, or the new launcher as Home)
export TV_PRIVATE_DNS=yes                # Android 12 supports Private DNS (DoT) — an on-device ad-block option here
