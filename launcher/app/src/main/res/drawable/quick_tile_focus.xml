<?xml version="1.0" encoding="utf-8"?>
<!-- Cheap focus highlight for a quick-launch tile: a white ring drawn as the tile's foreground when
     focused, so moving the highlight does not re-composite the banner bitmap (scaling did, which was
     slow on the MT5891). Transparent otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
